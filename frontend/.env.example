# Copy this file to .env and fill in real values (or set it in your host's
# dashboard, e.g. Vercel's Environment Variables page).
#
# URL of the deployed backend (Railway, etc.). Leave unset for local dev —
# it defaults to http://localhost:8000. The websocket URL is derived from
# this automatically (http -> ws, https -> wss).
VITE_API_URL=https://your-backend.up.railway.app
